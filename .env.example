# MathBot configuration template
# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in your values:
#
#     copy .env.example .env        (Windows)
#     cp .env.example .env          (macOS / Linux)
#
# `.env` is gitignored and must NEVER be committed - it holds your API key.
# This file IS committed, so it must never contain a real secret.

# --- Environment -----------------------------------------------------------
# local | staging | production
# `local` enables /docs and full error messages. Anything else disables both.
ENV=local

# --- Database --------------------------------------------------------------
# Default: SQLite, zero setup, works immediately.
DATABASE_URL=sqlite+aiosqlite:///./mathbot.db
#
# With docker compose (note port 5433 on the host):
# DATABASE_URL=postgresql+asyncpg://mathbot:mathbot@localhost:5433/mathbot
#
# Must use an ASYNC driver (+aiosqlite or +asyncpg). A sync URL makes the app
# hang with no error - the startup validator rejects it for that reason.

# Log every SQL statement. Very noisy; useful when debugging a query.
DATABASE_ECHO=false

# --- Cache -----------------------------------------------------------------
# Empty = in-process cache (per-worker, cleared on restart). Fine locally.
# Set it for a shared cache; docker compose exposes Redis on 6380.
REDIS_URL=
# REDIS_URL=redis://localhost:6380/0

# --- LLM provider ----------------------------------------------------------
# gemini | anthropic | openai | mock
#
# gemini is the default: it is the only one of the three with a real free
# tier, which is the deciding factor for a personal study tool.
# `mock` returns canned responses so you can build and run tests with no key
# and no quota use at all.
LLM_PROVIDER=gemini

# Leave empty to let the app pick a sensible model your key can actually
# reach. Set it to pin one explicitly.
LLM_MODEL=

# --- API keys --------------------------------------------------------------
# Only the key matching LLM_PROVIDER above needs a value. Leave the rest blank.
# Paste after the '=' with NO quotes, NO spaces, NO trailing space.

# Free tier, no credit card: https://aistudio.google.com/apikey
# Check your actual rate limits at https://aistudio.google.com/rate-limit
# NOTE: on the free tier Google may use your prompts to improve their
# products. Fine for your own practice questions; know it before you rely on
# it for anything private.
GEMINI_API_KEY=

# Paid only, no free tier: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Paid only: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# --- Rate limiting ---------------------------------------------------------
# These exist to protect the free-tier quota from ACCIDENT more than abuse: a
# re-render loop or a double-tapped Generate can spend a day's allowance in a
# minute, and it arrives as "the app stopped working" with no explanation.
#
# Set any limit to 0 to disable that window.
RATE_LIMIT_ENABLED=true

# Endpoints that call the model: solve, generate, review, ocr.
RATE_LIMIT_LLM_PER_MINUTE=12
RATE_LIMIT_LLM_PER_DAY=400

# Database-only reads and writes. Generous — these cost a local query.
RATE_LIMIT_STANDARD_PER_MINUTE=240

# Set to true ONLY when a reverse proxy sits in front of the API. It makes the
# app trust X-Forwarded-For for rate-limit identity, and that header is
# client-supplied — trusting it without a proxy lets anyone mint unlimited
# buckets while the limiter still appears to work.
TRUST_PROXY_HEADER=false

# --- Production only -------------------------------------------------------
# Used by docker-compose.prod.yml, which refuses to start without them rather
# than falling back to a development default in production.
#
# POSTGRES_PASSWORD=
# CORS_ORIGINS=["https://mathbot.example.com"]
# NEXT_PUBLIC_API_URL=https://mathbot.example.com/api/v1

# --- Frontend --------------------------------------------------------------
# Where the browser reaches the API. NEXT_PUBLIC_ is required for Next.js to
# expose it to browser code, and it is inlined at BUILD time - changing it
# needs a rebuild, not just a restart.
#
# This one lives in frontend/.env.local, not here. Repeated for reference:
# NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
